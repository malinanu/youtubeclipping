{
	admin off
	auto_https off
	servers {
		# Keep the real client IP from the host reverse proxy (CloudPanel/nginx, Cloudflare Tunnel).
		trusted_proxies static private_ranges
	}
}

:80 {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# API, SSE and media go straight to Go (no buffering, Range requests intact).
	handle /api/* {
		request_body /api/settings/cookies {
			max_size 2MB
		}
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}

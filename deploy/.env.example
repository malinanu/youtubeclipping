# Copy to .env and fill in.  cp .env.example .env
# Use alphanumeric values for passwords (they are embedded in connection URLs):  openssl rand -hex 24

HTTP_PORT=8088
POSTGRES_PASSWORD=change-me-hex
REDIS_PASSWORD=change-me-hex

# --- Admin login ---
ADMIN_EMAIL=you@example.com
# Generate with:  docker compose run --rm --no-deps api hashpw 'your-long-password'
# (prints the bcrypt hash base64-encoded, so it has no "$" and needs no quoting)
ADMIN_PASSWORD_HASH=paste-hashpw-output
# openssl rand -base64 48
SESSION_SECRET=replace-with-48-random-bytes-base64
# true when served over HTTPS (recommended); false only for plain-HTTP local testing.
COOKIE_SECURE=true

# --- AI clip suggestions (can also be set in the UI) ---
# auto = Claude if ANTHROPIC_API_KEY is set, otherwise Gemini
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Optional transcription API fallback (can also be set in the UI) ---
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Postiz (can also be set in the UI) ---
# Self-hosted Public API base, e.g. https://postiz.example.com/api/public/v1
POSTIZ_API_URL=
POSTIZ_API_KEY=

# --- Performance (Ampere A1 4 OCPU / 24 GB defaults) ---
# Whisper model to download at first start: tiny, base, small, medium, large-v3-turbo (.en = English only)
WHISPER_MODEL=small
WHISPER_THREADS=4
# 1 = greedy decoding (fast, low RAM). 5 = whisper.cpp's slower beam search.
WHISPER_BEAM_SIZE=1
# 0 stops repetition loops on long audio; -1 = whisper default
WHISPER_MAX_CONTEXT=0
# Heavy jobs (transcription, renders) allowed at once — 1 avoids out-of-memory kills
HEAVY_JOBS=1
FFMPEG_THREADS=4
RENDER_CONCURRENCY=1
TRANSCRIBE_CONCURRENCY=1
INGEST_CONCURRENCY=2
PROXY_HEIGHT=360
# Editor previews + audio are deleted after N days; rendered clips are kept.
MEDIA_RETENTION_DAYS=14
# Direct file uploads (kept until you delete the video): max size, and chunk size
# per request (must be below nginx client_max_body_size; 8 fits the default 10m)
MAX_UPLOAD_GB=20
UPLOAD_CHUNK_MB=8

# --- YouTube blocking workarounds (optional) ---
# Residential/ISP proxy for yt-dlp, e.g. http://user:pass@host:port
YTDLP_PROXY=
# Extra yt-dlp flags, space separated
YTDLP_EXTRA_ARGS=
